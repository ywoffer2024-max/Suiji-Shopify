  "suiji_v40": {
    "home": {
      "hero_title": "Defined by you.",
      "story_title": "Jewelry that moves to your rhythm",
      "story_lead": "One ornament. More ways to wear it.",
      "story_body": "Our handmade jewelry has evolved through conversations with customers since 2014. In our custom work, we often saw the same wish: a favorite detail carried across matching pieces, or a different charm for each occasion, without buying the same parts again. SUIJI grew from that idea. Our bases, interchangeable charms and Core-Lock connection let you build on what you already have and make the combinations your own. We’re working toward a future where everyone can wear jewelry they’ve had a hand in designing.",
      "ornament": "Ornament",
      "base": "Base",
