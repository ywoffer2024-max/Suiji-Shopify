{{ 'suiji-shop-all-photo.css' | asset_url | stylesheet_tag }}
{%- if request.locale.iso_code contains 'fr' -%}

<div class="r-site r-photo-catalogue" data-r107-page data-family="all" data-modules="1,2,3,4,5" data-photo-catalogue>
  <header class="r-intro r-intro--small">
    <p class="r-eyebrow">Aperçu de l’atelier</p>
    <h1>Tous les bijoux</h1>
    <p>Découvrez les créations de l’atelier SUIJI. Ouvrez une pièce pour voir ses finitions et ses différents angles.</p>
  </header>
  <div class="r-catalogue" data-catalogue>
    <div class="r-filter-bar">
      <button class="r-button r-button--line" type="button" data-open-filters>Filtrer <span data-filter-count></span></button>
      <p data-result-count aria-live="polite">51 pièces</p>
      <label>Trier <select data-sort><option value="original">Sélection</option><option value="name">Nom A–Z</option></select></label>
    </div>
    <div class="r-catalogue__layout">
      <dialog class="r-filters" id="r-filters" aria-labelledby="r-filter-title">
        <div class="r-filters__head"><h2 id="r-filter-title">Votre sélection</h2><button type="button" data-close-filters aria-label="Fermer les filtres">×</button></div>
        <fieldset><legend>Type de pièce</legend><label><input type="checkbox" name="role" value="rings"> Bagues</label><label><input type="checkbox" name="role" value="earrings"> Boucles d’oreilles</label><label><input type="checkbox" name="role" value="necklaces"> Colliers</label><label><input type="checkbox" name="role" value="charms"> Ornements</label><label><input type="checkbox" name="role" value="components"> Éléments</label><label><input type="checkbox" name="role" value="studies"> Études de design</label></fieldset>
        <button type="button" class="r-link" data-clear-filters>Effacer les filtres</button>
      </dialog>
      <div class="r-results">
        <div class="r-grid">
