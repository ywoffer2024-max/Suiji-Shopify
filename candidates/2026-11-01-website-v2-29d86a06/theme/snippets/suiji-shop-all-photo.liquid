{% style %}
.r-photo-catalogue[data-family="extras"] [data-open-filters] { display: none; }
.suiji-preview-label { margin-bottom: 0.35rem; }
.suiji-preview-dialog { width: min(56rem, calc(100% - 2rem)); max-height: 90vh; padding: clamp(1rem, 3vw, 2.4rem); border: 1px solid #d5dde3; overflow: auto; color: #1d252d; }
.suiji-preview-dialog::backdrop { background: rgb(16 25 35 / 55%); }
.suiji-preview-dialog__head { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
.suiji-preview-dialog__head h2 { margin: 0; }
.suiji-preview-dialog select { min-height: 44px; max-width: 100%; margin: 0.4rem; }
.suiji-preview-dialog__body { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
.suiji-preview-dialog__body [data-photo-main] { display: block; width: 100%; height: auto; max-height: 65vh; object-fit: contain; }
.suiji-preview-dialog__thumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
.suiji-preview-dialog__thumbs button { padding: 0; min-width: 44px; min-height: 44px; border: 1px solid #d5dde3; background: white; cursor: pointer; }
.suiji-preview-dialog__thumbs button[aria-pressed="true"] { border-color: #172936; outline: 1px solid #172936; }
.suiji-preview-dialog__thumbs img { display: block; width: 60px; height: 75px; object-fit: contain; }
@media (max-width: 749px) { .suiji-preview-dialog__body { grid-template-columns: 1fr; } .suiji-preview-dialog__body [data-photo-main] { max-height: 46vh; } }
{% endstyle %}

