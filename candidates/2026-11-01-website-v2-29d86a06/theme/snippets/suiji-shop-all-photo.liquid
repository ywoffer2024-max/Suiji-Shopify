{%- assign extras_catalogue = false -%}
{%- if catalogue_family == 'extras' -%}
  {%- assign extras_catalogue = true -%}
{%- endif -%}
{{ 'suiji-shop-all-photo.css' | asset_url | stylesheet_tag }}
{%- if request.locale.iso_code contains 'fr' -%}

<div class="r-site r-photo-catalogue" data-r107-page data-family="{% if extras_catalogue %}extras{% else %}all{% endif %}" data-modules="1,2,3,4,5" data-photo-catalogue>
  <header class="r-intro r-intro--small">
    <p class="r-eyebrow">Aperçu de l’atelier</p>
    {% if extras_catalogue %}<h1>Accessoires</h1>{% else %}<h1>Tous les bijoux</h1>{% endif %}
    {% if extras_catalogue %}<p>Crochets et supports de pendentif pour les bijoux SUIJI compatibles. Ouvrez une pièce pour voir ses finitions et ses différents angles.</p>{% else %}<p>Découvrez les bijoux et les créations présentées en aperçu d’atelier. Ouvrez une pièce pour voir ses finitions et ses différents angles.</p>{% endif %}
  </header>
  <div class="r-catalogue" data-catalogue>
    <div class="r-filter-bar">
      <button class="r-button r-button--line" type="button" data-open-filters>Filtrer <span data-filter-count></span></button>
      <p data-result-count aria-live="polite">{% if extras_catalogue %}5{% else %}43{% endif %} pièces</p>
      <label>Trier <select data-sort><option value="original">Sélection</option><option value="name">Nom A–Z</option></select></label>
    </div>
    <div class="r-catalogue__layout">
      <dialog class="r-filters" id="r-filters" aria-labelledby="r-filter-title">
        <div class="r-filters__head"><h2 id="r-filter-title">Votre sélection</h2><button type="button" data-close-filters aria-label="Fermer les filtres">×</button></div>
        <fieldset><legend>Type de pièce</legend><label><input type="checkbox" name="role" value="rings"> Bagues</label><label><input type="checkbox" name="role" value="earrings"> Boucles d’oreilles</label><label><input type="checkbox" name="role" value="necklaces"> Colliers</label><label><input type="checkbox" name="role" value="charms"> Ornements</label><label><input type="checkbox" name="role" value="components"> Éléments</label></fieldset>
        <button type="button" class="r-link" data-clear-filters>Effacer les filtres</button>
      </dialog>
      <div class="r-results">
        <div class="r-grid">
