{%- liquid
  assign piece_locale = 'en'
  if request.locale.iso_code contains 'fr'
    assign piece_locale = 'fr'
  endif
  assign all_path = routes.root_url | append: '/collections/all' | replace: '//', '/'
  assign image_root = 'https://cdn.shopify.com/s/files/1/1041/4112/8020/files/'
  assign default_finish = piece.finishes.first
  assign default_view = default_finish.views.first
  assign default_image = image_root | append: default_view.file
  assign image_widths = '420,560,840,1120,1400' | split: ','
  assign piece_title = piece.title[piece_locale]
  assign default_alt = piece_title | append: ' · ' | append: default_finish.label[piece_locale] | append: ' · ' | append: default_view.label[piece_locale]
  if piece_locale == 'fr'
    assign back_label = 'Tous les bijoux'
    assign breadcrumb_label = 'Fil d’Ariane'
    assign preview_label = 'Aperçu de l’atelier'
    assign gallery_label = 'Galerie'
    assign finish_label = 'Finition'
    assign detail_label = 'Détails'
    assign original_label = 'Ouvrir l’image en pleine résolution'
  else
    assign back_label = 'Shop all'
    assign breadcrumb_label = 'Breadcrumb'
    assign preview_label = 'Studio preview'
    assign gallery_label = 'Gallery'
    assign finish_label = 'Finish'
    assign detail_label = 'Details'
    assign original_label = 'Open full-size image'
  endif
-%}
{{ 'suiji-studio-piece.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suiji-studio-piece.js' | asset_url }}" defer></script>
<div class="r-site r-studio-piece" data-r107-page data-family="studio-piece" data-studio-piece="{{ piece.group | escape }}">
  <nav class="r-breadcrumb" aria-label="{{ breadcrumb_label }}">
    <a href="{{ all_path }}">{{ back_label }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ piece_title | escape }}</span>
  </nav>
  <div class="r-studio-piece__layout">
    <header class="r-studio-piece__heading">
      <p class="r-eyebrow">{{ preview_label }} · {{ piece.category[piece_locale] | escape }}</p>
      <h1>{{ piece_title | escape }}</h1>
      <p class="r-studio-piece__intro">{{ piece.description[piece_locale] | escape }}</p>
    </header>
    <section class="r-studio-piece__gallery" aria-label="{{ gallery_label }}">
      <figure class="r-studio-piece__figure">
        <img data-studio-main src="{{ default_image }}?width=840"
          srcset="{%- for width in image_widths -%}{{ default_image }}?width={{ width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
          sizes="(max-width: 749px) calc(100vw - 40px), (max-width: 1100px) 48vw, 620px"
          width="1400" height="1750" alt="{{ default_alt | escape }}" fetchpriority="high" decoding="async">
        <figcaption data-studio-caption aria-live="polite">{{ default_finish.label[piece_locale] | escape }} · {{ default_view.label[piece_locale] | escape }}</figcaption>
      </figure>
      {%- for finish in piece.finishes %}
        <div class="r-studio-piece__thumbs" data-studio-angles="{{ finish.key | escape }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- assign is_first_finish = forloop.first -%}
          {%- for view in finish.views %}
            {%- assign view_image = image_root | append: view.file -%}
            {%- assign view_alt = piece_title | append: ' · ' | append: finish.label[piece_locale] | append: ' · ' | append: view.label[piece_locale] -%}
            <a href="{{ view_image }}" data-studio-angle data-photo-alt="{{ view_alt | escape }}"
              data-photo-caption="{{ finish.label[piece_locale] | escape }} · {{ view.label[piece_locale] | escape }}"
              aria-label="{{ view.label[piece_locale] | escape }}"{% if forloop.first and is_first_finish %} aria-current="true"{% endif %}>
              <img src="{{ view_image }}?width=140" width="140" height="175" alt="" loading="lazy" decoding="async">
            </a>
          {%- endfor %}
        </div>
      {%- endfor %}
      <a class="r-link r-studio-piece__original" data-studio-original href="{{ default_image }}" target="_blank" rel="noopener">
        {{ original_label }} <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="r-studio-piece__details" aria-label="{{ detail_label }}">
      {% if piece.finishes.size > 1 %}
        <div class="r-studio-piece__finish" data-studio-finish-control hidden>
          <label for="StudioPieceFinish">{{ finish_label }}</label>
          <select id="StudioPieceFinish" data-studio-finish>
            {%- for finish in piece.finishes %}
              <option value="{{ finish.key | escape }}">{{ finish.label[piece_locale] | escape }}</option>
            {%- endfor %}
          </select>
        </div>
      {% endif %}
      <h2>{{ detail_label }}</h2>
      <dl class="r-studio-piece__facts">
        {%- for fact in piece.facts %}
          <div><dt>{{ fact.label[piece_locale] | escape }}</dt><dd>{{ fact.value[piece_locale] | escape }}</dd></div>
        {%- endfor %}
      </dl>
      <a class="r-link" href="{{ all_path }}"><span aria-hidden="true">←</span> {{ back_label }}</a>
    </section>
  </div>
</div>
