{% if request.page_type == 'collection' and collection.all_products_count == 0 %}
  <div class="r-site" data-r107-page data-family="bracelets">
    <header class="r-intro r-intro--small">
      {% if request.locale.iso_code contains 'fr' %}
        <h1>Bracelets</h1>
        <h2>Bientôt disponibles</h2>
        <p>Nos premières pièces pour le poignet sont en préparation.</p>
        <a class="r-button r-button--line" href="{{ routes.root_url | append: '/collections/all' | replace: '//', '/' }}">Voir tous les bijoux</a>
      {% else %}
        <h1>Bracelets &amp; bangles</h1>
        <h2>Coming soon</h2>
        <p>Our first pieces for the wrist are in preparation.</p>
        <a class="r-button r-button--line" href="{{ routes.root_url | append: '/collections/all' | replace: '//', '/' }}">Explore all jewelry</a>
      {% endif %}
    </header>
    <img class="suiji-bracelet-preview__photo" src="{{ 'suiji-home-bracelet-optimized.webp' | asset_url }}" width="1254" height="1254" alt="{% if request.locale.iso_code contains 'fr' %}Un jonc argenté et un bracelet à chaîne bleue{% else %}A silver-tone bangle and a blue chain bracelet{% endif %}" decoding="async">
  </div>
{% else %}
{%- if request.locale.iso_code contains 'fr' -%}
