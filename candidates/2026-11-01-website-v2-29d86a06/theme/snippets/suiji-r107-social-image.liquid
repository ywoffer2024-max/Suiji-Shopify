  if template.suffix contains 'suiji-p-'
   assign r107_social_key = template.suffix | remove_first: 'suiji-p-'
   case r107_social_key
    when 'r01-ring-base'
     assign r107_social_file = 'suiji-final2-white-A088-1200.webp'
    when 'r02-ring-base'
     assign r107_social_file = 'suiji-final2-white-A091-1200.webp'
