{%- liquid
  assign is_base = false
  assign is_charm = false
  if product.tags contains 'role:ring_base' or product.tags contains 'role:earring_base' or product.tags contains 'role:necklace_base' or product.tags contains 'role:bracelet_base' or product.tags contains 'role:pendant_holder'
    assign is_base = true
  elsif product.tags contains 'role:charm'
    assign is_charm = true
  endif
  assign pairs = product.metafields.custom.suiji_compatible_products.value
  assign french = false
  if request.locale.iso_code contains 'fr'
    assign french = true
  endif
-%}
{% if product.tags contains 'suiji-reviewed-storefront' %}
  {% if is_base or is_charm %}
    {%- assign total = 0 -%}
    {%- capture pair_cards -%}
      {%- for partner in pairs -%}
        {%- if partner.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if is_base -%}
          {%- unless partner.tags contains 'role:charm' -%}{%- continue -%}{%- endunless -%}
        {%- else -%}
          {%- unless partner.tags contains 'role:ring_base' or partner.tags contains 'role:earring_base' or partner.tags contains 'role:necklace_base' or partner.tags contains 'role:bracelet_base' or partner.tags contains 'role:pendant_holder' -%}
            {%- continue -%}
          {%- endunless -%}
        {%- endif -%}
        {%- capture card -%}{% render 'suiji-storefront-card', piece: partner %}{%- endcapture -%}
        {%- assign card = card | strip -%}
        {%- if card != blank -%}
          <li>{{ card }}</li>
          {%- assign total = total | plus: 1 -%}
          {%- if total == 2 -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <section class="suiji-native-pairing" aria-label="{{ 'suiji_pdp.pairing_title' | t | escape }}">
      <h2>{{ 'suiji_pdp.pairing_title' | t }}</h2>
      {% if total > 0 %}
        <ul class="suiji-native-pairing__grid" role="list">{{ pair_cards }}</ul>
      {% elsif is_base %}
        <p>{% if french %}Vérifiez le type de fixation avant d’ajouter un ornement.{% else %}Check this piece’s connection before adding a charm.{% endif %}</p>
        <a class="r-link" href="{{ routes.root_url | append: '/pages/charms' | replace: '//', '/' }}">{% if french %}Choisir un ornement{% else %}Choosing a charm{% endif %}</a>
      {% else %}
        <p>{% if french %}Vérifiez quelles bases acceptent ce type de fixation.{% else %}Check which bases accept this type of connection.{% endif %}</p>
        <a class="r-link" href="{{ routes.root_url | append: '/pages/bases' | replace: '//', '/' }}">{% if french %}Choisir une base{% else %}Choosing a base{% endif %}</a>
      {% endif %}
    </section>
  {% endif %}
{% endif %}
