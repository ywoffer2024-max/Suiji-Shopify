{% doc %}
Native Journal presentation. Title, body, dates and language come from Shopify.
@param {article} article - The actual published Article.
@param {blog} blog - Its owning blog.
{% enddoc %}
{{ 'suiji-journal-v2.css' | asset_url | stylesheet_tag }}
{% assign sj_fr = false %}{% if request.locale.iso_code contains 'fr' %}{% assign sj_fr = true %}{% endif %}
{% assign sj_excerpt_text = article.excerpt | strip_html | strip %}
{% assign sj_body_text = article.content | strip_html | strip %}
<article class="sj-entry" lang="{{ request.locale.iso_code }}">
<header class="sj-entry-head"><div class="sj-shell"><a href="{{ blog.url }}">← {% if sj_fr %}Retour au Journal{% else %}Back to Journal{% endif %}</a><p class="sj-eyebrow">SUIJI Journal</p><h1>{{ article.title | escape }}</h1>{% if sj_excerpt_text != blank %}{% unless sj_body_text contains sj_excerpt_text %}<p class="sj-deck">{{ sj_excerpt_text | escape }}</p>{% endunless %}{% endif %}<p class="sj-byline">{{ article.author | escape }} · {{ article.published_at | time_tag: format: 'date' }}</p></div></header>
<div class="sj-shell sj-reading-layout"><aside class="sj-reader-note"><p class="sj-eyebrow">{% if sj_fr %}Pour vous aider à choisir{% else %}For your next choice{% endif %}</p><p>{% if sj_fr %}Commencez par les critères qui comptent pour vous, puis notez ce qu’il reste à vérifier.{% else %}Start with the criteria that matter to you, then note what you still need to check.{% endif %}</p><a href="{{ blog.url }}#journal-themes">{% if sj_fr %}Explorer les six thèmes{% else %}Explore the six themes{% endif %} →</a></aside><div class="sj-entry-body">{% if article.image %}<figure class="sj-decision-map">{{ article.image | image_url: width: 1200 | image_tag: widths: '390, 600, 900, 1200', sizes: '(max-width: 989px) 90vw, 65vw', loading: 'eager', alt: article.image.alt }}</figure>{% endif %}{{ article.content }}</div></div>
<footer class="sj-shell sj-native-footer"><h2>{% if sj_fr %}Pour poursuivre{% else %}Keep exploring{% endif %}</h2><div class="sj-native-related">{% assign sj_related_count = 0 %}{% assign sj_theme = '' %}{% for tag in article.tags %}{% if tag contains 'theme-h' %}{% assign sj_theme = tag %}{% endif %}{% endfor %}{% for related in blog.articles %}{% if related.id != article.id and sj_related_count < 3 %}{% if sj_theme == blank or related.tags contains sj_theme %}<a href="{{ related.url }}">{{ related.title | escape }} →</a>{% assign sj_related_count = sj_related_count | plus: 1 %}{% endif %}{% endif %}{% endfor %}<a href="{{ routes.root_url | append: '/collections/all' | replace: '//', '/' }}">{% if sj_fr %}Explorer les bijoux{% else %}Explore the jewelry{% endif %} →</a></div></footer>
</article><script type="application/ld+json">{{ article | structured_data }}</script>
