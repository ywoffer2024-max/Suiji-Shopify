{%- doc -%}
  Render social metadata, optionally using the current information page's translated metadata.
  @param {string} [seo_title] - Optional page-specific title.
  @param {string} [seo_description] - Optional page-specific description.
  @param {string} [seo_url] - Optional resolved canonical URL for this presentation.
{%- enddoc -%}
{%- liquid
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_url = seo_url | default: canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- capture r107_social_file -%}{% render 'suiji-r107-social-image' %}{%- endcapture -%}
{%- liquid
  assign r107_social_file = r107_social_file | strip
  assign r107_social_url = ''
  if r107_social_file != blank
    assign r107_social_url = r107_social_file | asset_url
    assign r107_social_prefix = r107_social_url | slice: 0, 2
    if r107_social_prefix == '//'
      assign r107_social_url = r107_social_url | prepend: 'https:'
    endif
  endif
-%}
{%- if r107_social_url != blank -%}
  <meta property="og:image" content="{{ r107_social_url | escape }}">
  <meta property="og:image:secure_url" content="{{ r107_social_url | escape }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  <meta name="twitter:image" content="{{ r107_social_url | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
{%- unless product.tags contains 'suiji-display-only' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endunless -%}
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="{% if r107_social_url != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
