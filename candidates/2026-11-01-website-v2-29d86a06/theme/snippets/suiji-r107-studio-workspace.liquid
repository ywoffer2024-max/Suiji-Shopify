{%- assign beta_url = routes.root_url | append: '/pages/design-studio' | replace: '//', '/' -%}
<div class="r-site" data-r107-page data-family="studio-intro">
  <header class="r-intro">
    <p class="r-eyebrow">{{ 'suiji_charm_beta.status' | t | escape }}</p>
    <h1>{{ 'suiji_charm_beta.legacy_heading' | t | escape }}</h1>
    <p>{{ 'suiji_charm_beta.legacy_body' | t | escape }}</p>
    <a class="r-button" href="{{ beta_url }}">{{ 'suiji_charm_beta.submit' | t | escape }}</a>
  </header>
</div>
