    {%- endif -%}
  {%- when 'related' -%}
    {%- liquid
      case piece.category.en
        when 'Earrings'
          assign related_handles = 'piece-rounded-rectangle-hoops,piece-round-hoops,piece-rectangle-hoops-with-coin-drop,piece-round-hoops-with-coin-drop'
        when 'Necklace'
          assign related_handles = 'piece-6-link-collar,piece-7-link-collar,piece-9-link-collar,piece-rolled-link-chain-with-pendant-holder'
        when 'Charm'
          assign related_handles = 'piece-stone-inlay-charm,piece-bezel-set-round-charm,piece-blue-green-stone-charm,piece-polished-faceted-round-charm'
        when 'Component'
          assign related_handles = 'piece-hook-01,piece-hook-02,piece-pendant-holder-01,piece-quarter-turn-pendant-holder'
        when 'Design study'
          assign related_handles = 'piece-rounded-rectangle-charm-study,piece-faceted-square-charm-study'
      endcase
      assign related_handles = related_handles | split: ','
      assign rendered_cards = 0
    -%}
    {% if related_handles.size > 0 %}
      <section class="r-complete-look">
        <div class="r-section__heading"><h2>{{ title }}</h2></div>
        <div class="r-complete-look__grid">
          {%- for handle in related_handles -%}
            {%- if handle == piece.handle -%}{%- continue -%}{%- endif -%}
            {%- assign related = pages[handle].metafields.suiji.studio_piece.value -%}
            {%- unless related.schema == 'suiji-studio-piece/1' -%}{%- continue -%}{%- endunless -%}
            {%- assign related_url = routes.root_url | append: '/pages/' | append: handle | replace: '//', '/' -%}
            {%- assign related_name = related.title[piece_locale] -%}
            {%- assign related_finish = related.finishes.first -%}
            {%- assign related_view = related_finish.views.first -%}
            {%- assign related_photo = image_root | append: related_view.file -%}
            <article class="r-complete-card">
              <div class="r-complete-card__image">
                <a href="{{ related_url }}" aria-label="{{ related_name | escape }}">
                  <img src="{{ related_photo }}?width=420" width="420" height="525" alt="" loading="lazy" decoding="async">
                </a>
              </div>
              <a class="r-complete-card__title" href="{{ related_url }}">{{ related_name | escape }}</a>
              <span class="r-caption">{{ preview_label | escape }}</span>
            </article>
            {%- assign rendered_cards = rendered_cards | plus: 1 -%}
            {%- if rendered_cards == 3 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {% endif %}
{%- endcase -%}
