{% assign sj_root = routes.root_url | append: '/blogs/journal' | replace: '//', '/' %}
{% if sj_id == 4 %}{{ 'suiji-v40.css' | asset_url | stylesheet_tag }}{% endif %}
<article class="sj-entry" data-sj-entry="{{ sj_id }}" lang="{{ sj_lang }}">
  <header class="sj-entry-head"><div class="sj-shell"><a href="{{ sj_root }}">{% if sj_lang == 'fr' %}Retour au Journal{% else %}Back to Journal{% endif %} &larr;</a><p class="sj-eyebrow">{{ sj_direction | strip }}</p><h1>{{ sj_title | strip }}</h1><p class="sj-deck">{{ sj_summary | strip }}</p><p class="sj-byline">SUIJI Journal · <time datetime="2026-10-30">{% if sj_lang == 'fr' %}30 octobre 2026{% else %}October 30, 2026{% endif %}</time></p>{% if sj_id == 4 %}<p class="sj-byline sj-byline--updated">{{ 'suiji_v40.journal.updated' | t }} · <time datetime="2026-10-31">{{ 'suiji_v40.journal.review_date' | t }}</time></p>{% endif %}</div></header>
  <div class="sj-shell sj-reading-layout"><aside class="sj-reader-note"><p class="sj-eyebrow">{% if sj_lang == 'fr' %}À emporter{% else %}Take it with you{% endif %}</p><p>{% if sj_lang == 'fr' %}Un choix concret, des informations à vérifier et une prochaine étape adaptée à votre situation.{% else %}A concrete choice, the information to check and a next step suited to your situation.{% endif %}</p><a href="{{ sj_root }}#journal-themes">{% if sj_lang == 'fr' %}Explorer les six thèmes{% else %}Explore the six themes{% endif %} →</a></aside><div class="sj-entry-body">{% if sj_id == 4 %}<div class="sj-component-check" role="group" aria-label="{{ 'suiji_v40.journal.check_label' | t | escape }}"><ol role="list"><li><strong>{{ 'suiji_v40.journal.base' | t }}</strong><span>{{ 'suiji_v40.journal.base_text' | t }}</span></li><li><strong>{{ 'suiji_v40.journal.ornament' | t }}</strong><span>{{ 'suiji_v40.journal.ornament_text' | t }}</span></li><li><strong>{{ 'suiji_v40.journal.extra' | t }}</strong><span>{{ 'suiji_v40.journal.extra_text' | t }}</span></li></ol></div>{% else %}<figure class="sj-decision-map"><img src="{{ sj_image | asset_url }}" width="1200" height="800" loading="eager" fetchpriority="high" alt="{{ sj_title | strip | escape }} — {% if sj_lang == 'fr' %}repère de décision en trois étapes{% else %}three-step decision map{% endif %}"><figcaption>{% if sj_lang == 'fr' %}Illustration éditoriale : une méthode de choix, pas un schéma de produit ni une certification.{% else %}Editorial illustration: a decision framework, not a product drawing or certification.{% endif %}</figcaption></figure>{% endif %}
