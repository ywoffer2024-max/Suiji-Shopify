{{ 'suiji-journal-v2.css' | asset_url | stylesheet_tag }}
{% assign sj_id = section.settings.article_id | plus: 0 %}{% assign sj_lang = 'en' %}{% if request.locale.iso_code contains 'fr' %}{% assign sj_lang = 'fr' %}{% endif %}
{% assign sj_number = sj_id | prepend: '0' | slice: -2, 2 %}
{% capture sj_title %}{% render 'suiji-journal-copy', key: sj_id, field: 'title' %}{% endcapture %}
{% capture sj_summary %}{% render 'suiji-journal-copy', key: sj_id, field: 'summary' %}{% endcapture %}
