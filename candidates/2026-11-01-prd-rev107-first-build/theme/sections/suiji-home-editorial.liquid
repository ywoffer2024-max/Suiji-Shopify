  assign hero_title = 'suiji_v40.home.hero_title' | t
  assign story_title = 'suiji_v40.home.story_title' | t
  assign story_lead = 'suiji_v40.home.story_lead' | t
  assign story_body = 'suiji_v40.home.story_body' | t
  assign about_title = 'suiji_v40.home.about_title' | t
  assign about_lead = 'suiji_v40.home.about_lead' | t
  assign about_body = 'suiji_v40.home.about_body' | t
