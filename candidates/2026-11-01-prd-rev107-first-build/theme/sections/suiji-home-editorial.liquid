{{ 'suiji-home-editorial.css' | asset_url | stylesheet_tag }}
{{ 'suiji-v40.css' | asset_url | stylesheet_tag }}
<script src="{{ 'suiji-home-editorial.js' | asset_url }}" defer></script>
