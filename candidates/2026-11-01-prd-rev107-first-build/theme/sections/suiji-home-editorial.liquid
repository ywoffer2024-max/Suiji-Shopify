  assign about_image = section.settings.about_image | default: 'suiji-home-about-optimized.webp'
  assign look_image = section.settings.look_image | default: 'suiji-home-look-optimized.webp'
  assign necklace_image = section.settings.necklace_image | default: 'suiji-home-necklace-optimized.webp'
  assign bracelet_image = section.settings.bracelet_image | default: 'suiji-home-bracelet-optimized.webp'
  assign ring_image = images['r01-blue-front-area17-559667e818a1ea03.png']
  assign hoop_image = images['h01-blue-hoop-314abc45f474.png']
  assign flower_a = images['mf-f01-front-f337b8015d3d1e41.png']
  assign flower_b = images['mf-f02-front-7866b0cf3fed3922.png']
  if is_fr
    assign hero_cta = 'Découvrir les bagues'
    assign shop_title = 'À explorer'
    assign story_cta = 'Découvrir le système SUIJI'
    assign studio_note = 'Concept d’atelier créé avec l’IA'
    assign size_title = 'Trouvez votre taille'
    assign size_body = 'Consultez notre guide et les correspondances internationales.'
    assign mechanism_title = 'Découvrez Core-Lock'
    assign mechanism_body = 'Explorez le principe d’assemblage et les compatibilités.'
    assign preview_title = 'Composez votre bijou'
    assign preview_body = 'Essayez une base et vos ornements dans l’aperçu interactif.'
    assign look_title = 'À vous de composer.'
    assign look_kicker = 'Votre composition'
    assign look_cta = 'Explorer la composition'
    assign newsletter_title = 'Un peu de SUIJI, de temps en temps.'
    assign newsletter_subtitle = 'Gardons le lien'
    assign newsletter_body = 'Nouvelles pièces, idées de composition et nouvelles de SUIJI.'
    assign email_label = 'Votre adresse e-mail'
    assign subscribe = 'S’inscrire'
    assign consent = 'J’accepte de recevoir les e-mails SUIJI. Je peux me désinscrire à tout moment.'
    assign privacy_label = 'Politique de confidentialité'
    assign subscribed = 'Merci. Votre inscription est bien enregistrée.'
    assign editorial_cta = 'Lire le journal'
    assign campaign_note = 'Visuels de campagne provisoires créés avec l’IA. Retrouvez les images disponibles dans l’aperçu produit.'
    assign hero_alt = 'Visuel de campagne : bague bleue et créole, sur une chemise blanche'
    assign modular_alt = 'Composition de bagues et d’ornements ovales dans des tons bleus et titane naturel'
    assign about_alt = 'Visuel de campagne : recherche de formes et de couleurs à une table de création'
    assign look_alt = 'Visuel de composition : bague bleue portée et ornement gris fumé'
  else
    assign hero_cta = 'Explore the rings'
    assign shop_title = 'Shop by'
    assign story_cta = 'Explore the SUIJI system'
    assign studio_note = 'AI studio concept'
    assign size_title = 'Find your size'
    assign size_body = 'Explore our ring size guide and international conversions.'
    assign mechanism_title = 'Meet Core-Lock'
    assign mechanism_body = 'Discover how the system works and what fits together.'
    assign preview_title = 'Make your combination'
    assign preview_body = 'Try a ring base and your charms in the interactive preview.'
    assign look_title = 'Make it your own.'
    assign look_kicker = 'Shop the look'
    assign look_cta = 'Explore this look'
    assign newsletter_title = 'A little SUIJI, now and then.'
    assign newsletter_subtitle = 'Stay in the loop'
    assign newsletter_body = 'New pieces, ways to wear them and notes from SUIJI.'
    assign email_label = 'Your email address'
    assign subscribe = 'Subscribe'
    assign consent = 'I agree to receive SUIJI emails. I can unsubscribe at any time.'
    assign privacy_label = 'Privacy policy'
    assign subscribed = 'Thank you. Your subscription is recorded.'
    assign editorial_cta = 'Read the journal'
    assign campaign_note = 'Temporary campaign visuals created with AI. See the product preview for the available images.'
    assign hero_alt = 'Campaign concept: a blue ring and hoop earring against a white shirt'
    assign modular_alt = 'A composition of blue and natural-titanium rings with oval charms'
    assign about_alt = 'Campaign concept: exploring jewelry shapes and colours at a design table'
