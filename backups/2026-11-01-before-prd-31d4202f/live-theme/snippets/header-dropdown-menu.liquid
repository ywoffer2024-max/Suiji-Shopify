{% comment %}
  Renders a standard dropdown style menu for the header.

  Usage:
  {% render 'header-dropdown-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- assign suiji_is_shop_all = false -%}{%- if link.url contains '/collections/all' -%}{%- assign suiji_is_shop_all = true -%}{%- endif -%}
      {%- assign suiji_is_sets = false -%}{%- if link.handle == 'sets' -%}{%- assign suiji_is_sets = true -%}{%- endif -%}
      {%- assign suiji_is_visual_menu = false -%}{%- if suiji_is_shop_all or suiji_is_sets -%}{%- assign suiji_is_visual_menu = true -%}{%- endif -%}
      <li class="{% if link.links != blank %}suiji-desktop-parent{% endif %}{% if suiji_is_visual_menu %} suiji-mega-root{% endif %}"{% if suiji_is_visual_menu %} data-suiji-mega-root{% endif %}>
        {%- if link.links != blank -%}
          <a id="HeaderMenu-{{ link.handle }}" href="{% render 'suiji-localized-menu-url', url: link.url %}" class="header__menu-item list-menu__item link link--text focus-inset">{%- render 'suiji-localized-menu-title', title: link.title -%}</a>
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}">
              <summary id="HeaderMenuToggle-{{ link.handle }}" class="header__menu-item list-menu__item link focus-inset" aria-labelledby="HeaderMenu-{{ link.handle }} HeaderMenuToggleLabel-{{ link.handle }}">
                <span id="HeaderMenuToggleLabel-{{ link.handle }}" class="visually-hidden">{{ 'suiji_navigation.labels.submenu' | t }}</span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <ul
                id="HeaderMenu-MenuList-{{ forloop.index }}"
                class="{% if suiji_is_visual_menu %}suiji-mega-menu {% endif %}{% if suiji_is_sets %}suiji-sets-mega-menu {% endif %}header__submenu list-menu list-menu--disclosure color-{{ section.settings.menu_color_scheme }} gradient caption-large motion-reduce global-settings-popup"
                role="list"
                tabindex="-1"
              >
                {%- if suiji_is_shop_all -%}{% render 'suiji-shop-mega-menu', links: link.links, parent_handle: link.handle %}{%- elsif suiji_is_sets -%}{% render 'suiji-sets-mega-menu' %}{%- else -%}
                {%- for childlink in link.links -%}
                  <li class="{% if childlink.links != blank %}suiji-desktop-child-parent{% endif %}">
                    {%- if childlink.links == blank -%}
                      <a
                        id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                        href="{% render 'suiji-localized-menu-url', url: childlink.url %}"
                        class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {%- render 'suiji-localized-menu-title', title: childlink.title -%}
                      </a>
                    {%- else -%}
                      <a id="HeaderMenuChild-{{ link.handle }}-{{ childlink.handle }}" href="{% render 'suiji-localized-menu-url', url: childlink.url %}" class="header__menu-item list-menu__item link link--text focus-inset caption-large">{%- render 'suiji-localized-menu-title', title: childlink.title -%}</a>
                      <details id="Details-HeaderSubMenu-{{ link.handle }}-{{ childlink.handle }}">
                        <summary
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          aria-labelledby="HeaderMenuChild-{{ link.handle }}-{{ childlink.handle }} HeaderSubmenuLabel-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__menu-item link link--text list-menu__item focus-inset caption-large"
                        >
                          <span id="HeaderSubmenuLabel-{{ link.handle }}-{{ childlink.handle }}" class="visually-hidden">{{ 'suiji_navigation.labels.submenu' | t }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </summary>
                        <ul
                          id="HeaderMenu-SubMenuList-{{ link.handle }}-{{ childlink.handle }}"
                          class="header__submenu list-menu motion-reduce"
                        >
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                href="{% render 'suiji-localized-menu-url', url: grandchildlink.url %}"
                                class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"
                                {% if grandchildlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {%- render 'suiji-localized-menu-title', title: grandchildlink.title -%}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                {%- endif -%}
              </ul>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{% render 'suiji-localized-menu-url', url: link.url %}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {%- render 'suiji-localized-menu-title', title: link.title -%}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
