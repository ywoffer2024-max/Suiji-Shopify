{%- doc -%}
  A priced card for reviewed native Shopify products.
  @param {product} piece - The published native product.
  @param {string} [family] - The card's category, when supplied by its collection.
  @param {boolean} [priority] - Load images visible on entry without waiting for scroll.
  @param {boolean} [budget] - Expose the price and product markers for budget results.
{%- enddoc -%}
{%- if piece != blank and piece.tags contains 'suiji-reviewed-storefront' -%}
  {%- capture cover -%}{% render 'suiji-storefront-cover', handle: piece.handle %}{%- endcapture -%}
  {%- liquid
    assign cover = cover | strip | split: '|'
    assign offer = piece.selected_or_first_available_variant
    assign cover_variant_id = cover[7] | plus: 0
    if cover_variant_id > 0
      for variant in piece.variants
        if variant.id == cover_variant_id and variant.price > 0
          if budget != true or variant.price == offer.price
            assign offer = variant
          endif
          break
        endif
      endfor
    endif
    assign image_under_review = false
    if cover_variant_id > 0 and cover[1] == blank
      assign image_under_review = true
    endif
    assign shows_cover = false
    if cover[1] != blank and offer.id == cover_variant_id
      assign shows_cover = true
    endif
    assign set_quote = piece.metafields.custom.suiji_set_quote.value
    if set_quote != blank
      assign family = 'sets'
    endif
    if family == blank
      for tag in piece.tags
        assign key = tag | split: ':' | first
        if key == 'category'
          assign family = tag | split: ':' | last
          break
        endif
      endfor
    endif
    assign locale = request.locale.iso_code | split: '-' | first
    if locale != 'fr'
      assign locale = 'en'
    endif
    assign info = piece.metafields.custom.suiji_display_copy.value[locale]
    assign name = set_quote.title[locale] | default: info.title | default: piece.title
    if piece.handle == 'r01' and name == 'R01'
      assign name = 'Brushed Ring Base'
      if locale == 'fr'
        assign name = 'Bague large brossée'
      endif
    endif
    assign loading = 'lazy'
    if priority
      assign loading = 'eager'
    endif
    assign href = routes.root_url | append: '/products/' | append: piece.handle | replace: '//', '/'
    assign href = href | append: '?variant=' | append: offer.id
  -%}
  {%- capture colour_hold -%}{% render 'suiji-colour-variant-hold', variant: offer %}{%- endcapture -%}
{%- assign colour_hold = colour_hold | strip -%}
  {%- assign fixed_circumference = nil -%}
{%- case piece.handle -%}
  {%- when 'suiji-photo-20261109-ring-03' -%}{%- assign fixed_circumference = 54 -%}
  {%- when 'suiji-photo-20261109-ring-05', 'suiji-photo-20261109-ring-09' -%}{%- assign fixed_circumference = 57 -%}
{%- endcase -%}
  {%- if offer != blank and offer.price > 0 -%}
    <article class="r-card suiji-reviewed-card" data-piece-card data-suiji-shop-product data-key="{{ piece.handle | escape }}" data-role="{{ family | escape }}" data-category="{{ family | escape }}"{% if budget %} data-gift-budget-product="{{ piece.handle | escape }}"{% endif %}>
      <a class="suiji-reviewed-card__link" href="{{ href | escape }}">
        {% if shows_cover %}
          <div class="r-card__image">{% render 'suiji-storefront-cover-image', cover: cover, loading: loading, sizes: 'card', family: family %}</div>
        {% endif %}
        <div class="r-card__meta">
          <h3>{{ name | replace: ' · 54 mm', ' · US 6¾' | replace: ' · 57 mm', ' · US 8' | escape }}</h3>
          {% if fixed_circumference %}<p class="r-caption">{{ 'suiji_sizing.inner_circumference_value' | t: measurement: fixed_circumference }}</p>{% endif %}
          <p class="r-price" data-card-price{% if budget %} data-gift-budget-price{% endif %}>{{ offer.price | money_with_currency }}</p>
          {%- if colour_hold == 'held' or image_under_review -%}
            <p class="r-card__state">{{ 'suiji_pdp.image_review_status' | t }}</p>
          {%- elsif set_quote != blank and shows_cover -%}
            <p class="r-card__state">{% if piece.featured_media.alt contains ' · Set contents' or piece.featured_media.alt contains ' · Full set' %}{% if locale == 'fr' %}Ensemble présenté{% else %}Set shown{% endif %}{% else %}{% if locale == 'fr' %}Composants présentés{% else %}Selected components{% endif %}{% endif %}</p>
          {%- elsif settings.suiji_enable_orders == false or piece.tags contains 'suiji-display-only' -%}
            <p class="r-card__state">{{ 'suiji_pdp.preview_status' | t }}</p>
          {%- endif -%}
        </div>
      </a>
    </article>
  {%- endif -%}
{%- endif -%}
