{% doc %}
  Product structured data using only the selected variant's admitted imagery.
  @param {product} product - Native product.
  @param {object} media - Current exact variant gallery.
  @param {string} title - Localized product name.
  @param {string} purchase_state - Effective purchase state.
{% enddoc %}
{%- assign selected = product.selected_or_first_available_variant -%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ title | json }},
  "url": {{ canonical_url | json }},
  "sku": {{ selected.sku | json }},
  "brand": { "@type": "Brand", "name": "SUIJI" },
  "image": [
    {%- for item in media -%}
      {%- assign image_url = item.preview_image | image_url: width: item.preview_image.width -%}
      {%- assign prefix = image_url | slice: 0, 2 -%}
      {%- if prefix == '//' -%}{%- assign image_url = image_url | prepend: 'https:' -%}{%- endif -%}
      {{- image_url | json -}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- if purchase_state == 'available' and settings.suiji_enable_orders -%},
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | append: '?variant=' | append: selected.id | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ selected.price | divided_by: 100.0 | json }},
    "availability": "https://schema.org/InStock"
  }
  {%- endif -%}
}
