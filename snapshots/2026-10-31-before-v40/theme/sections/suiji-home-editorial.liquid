    assign newsletter_title = 'Un peu de SUIJI, de temps en temps.'
    assign newsletter_subtitle = 'Gardons le lien'
    assign newsletter_body = 'Nouvelles pièces, idées de composition et nouvelles de SUIJI.'
    assign email_label = 'Votre adresse e-mail'
    assign subscribe = 'S’inscrire'
    assign consent = 'J’accepte de recevoir les e-mails SUIJI. Je peux me désinscrire à tout moment.'
    assign privacy_label = 'Politique de confidentialité'
