-%}
<suiji-home-editorial class="suiji-home" id="{{ home_id }}">
  <section class="suiji-home__hero" aria-labelledby="{{ home_id }}-hero">
    <div class="suiji-home__hero-image">{% render 'suiji-home-image', image: hero_image, alt: hero_alt, loading: 'eager', sizes: '(max-width: 587px) 600px, 100vw' %}</div>
    <div class="suiji-home__hero-copy"><h1 id="{{ home_id }}-hero">{{ hero_title }}</h1><a class="suiji-home__button" href="{% render 'suiji-localized-menu-url', url: '/collections/rings?view=suiji-product&product=r01-ring-base' %}">{{ hero_cta }}</a></div>
  </section>

  <section class="suiji-home__categories" aria-labelledby="{{ home_id }}-shop">
    <h2 id="{{ home_id }}-shop">{{ shop_title }}</h2>
    <div class="suiji-home__category-rail" role="group" aria-labelledby="{{ home_id }}-shop">
      {%- assign category_order = 'necklaces,bracelets_bangles,earrings,rings,charms,accessories' | split: ',' -%}
      {%- for category in category_order -%}
        {%- liquid
          assign collection_handle = category
          assign category_image = modular_image
          case category
            when 'necklaces'
              assign category_image = necklace_image
            when 'bracelets_bangles'
              assign collection_handle = 'bracelets'
              assign category_image = bracelet_image
            when 'earrings'
              assign category_image = hoop_image
            when 'rings'
              assign category_image = ring_image
            when 'charms'
              assign category_image = flower_b
            when 'accessories'
              assign collection_handle = 'extras'
          endcase
          assign category_url = '/collections/' | append: collection_handle
          assign category_key = 'suiji_navigation.labels.' | append: category
          assign category_label = category_key | t
        -%}
        <a class="suiji-home__category{% if category == 'accessories' %} suiji-home__category--composition{% endif %}" href="{% render 'suiji-localized-menu-url', url: category_url %}"><div>{% render 'suiji-home-image', image: category_image, alt: category_label, sizes: '(min-width: 990px) 15vw, 40vw' %}</div><span>{{ category_label }}</span></a>
      {%- endfor -%}
    </div>
  </section>

  <section class="suiji-home__story" id="ways-to-wear" aria-labelledby="{{ home_id }}-story">
    <div class="suiji-home__story-image">{% render 'suiji-home-image', image: modular_image, alt: modular_alt, sizes: '(max-width: 749px) 190vw, 100vw' %}</div>
    <div class="suiji-home__story-copy"><h2 id="{{ home_id }}-story">{{ story_title }}</h2><p class="suiji-home__lead">{{ story_lead }}</p><p>{{ story_body }}</p><a class="suiji-home__button" href="{% render 'suiji-localized-menu-url', url: '/pages/the-mechanism' %}">{{ story_cta }} <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="suiji-home__about" aria-labelledby="{{ home_id }}-about">
    <div class="suiji-home__about-image">{% render 'suiji-home-image', image: about_image, alt: about_alt, sizes: '(max-width: 749px) 500px, 100vw' %}<span class="suiji-home__image-note">{{ studio_note }}</span></div>
    <div class="suiji-home__about-copy"><h2 id="{{ home_id }}-about">{{ about_title }}</h2><p class="suiji-home__lead">{{ about_lead }}</p><p>{{ about_body }}</p><a class="suiji-home__button" href="{% render 'suiji-localized-menu-url', url: '/pages/about' %}">{{ about_cta }} <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="suiji-home__guides" aria-label="{{ story_cta | escape }}">
    <a href="{% render 'suiji-localized-menu-url', url: '/pages/bases#size-guide' %}"><span class="suiji-home__guide-number" aria-hidden="true">01</span><h2>{{ size_title }}</h2><p>{{ size_body }}</p></a>
    <a href="{% render 'suiji-localized-menu-url', url: '/pages/the-mechanism' %}"><span class="suiji-home__guide-number" aria-hidden="true">02</span><h2>{{ mechanism_title }}</h2><p>{{ mechanism_body }}</p></a>
    <a href="{% render 'suiji-localized-menu-url', url: '/collections/rings?view=suiji-product&product=r01-ring-base' %}"><span class="suiji-home__guide-number" aria-hidden="true">03</span><h2>{{ preview_title }}</h2><p>{{ preview_body }}</p></a>
  </section>

  <section class="suiji-home__look" aria-labelledby="{{ home_id }}-look">
    <div class="suiji-home__look-visual">
      {% render 'suiji-home-image', image: look_image, alt: look_alt, sizes: '(min-width: 750px) 50vw, 100vw' %}
      <div class="suiji-home__hotspots"><button type="button" data-home-hotspot="0" aria-label="{{ 'suiji_preview.base_title' | t | escape }}" disabled><span aria-hidden="true">+</span></button><button type="button" data-home-hotspot="1" aria-label="{{ 'suiji_preview.charm_a' | t | escape }}" disabled><span aria-hidden="true">+</span></button></div>
      <button type="button" class="suiji-home__button suiji-home__look-open" data-home-look-open disabled>{{ look_kicker }}</button>
    </div>
    <div class="suiji-home__look-panel"><div class="suiji-home__look-heading"><p class="suiji-home__kicker">{{ look_kicker }}</p><h2 id="{{ home_id }}-look">{{ look_title }}</h2></div><span data-home-look-marker></span>
      <div class="suiji-home__look-items" data-home-look-items>
        {%- for look_index in (0..2) -%}
          {%- liquid
            if look_index == 0
              assign item_image = ring_image
              assign item_title = 'suiji_preview.base_title' | t
              assign item_colour = 'suiji_preview.metal_blue' | t
              assign item_url = '/collections/rings?view=suiji-product&product=r01-ring-base'
            elsif look_index == 1
              assign item_image = flower_a
              assign item_title = 'suiji_preview.charm_a' | t
              assign item_colour = 'suiji_preview.stone_smoky' | t
              assign item_url = '/collections/charms?view=suiji-product&product=oval-motif'
            else
              assign item_image = flower_b
              assign item_title = 'suiji_preview.charm_b' | t
              assign item_colour = 'suiji_preview.stone_aqua' | t
              assign item_url = '/collections/charms?view=suiji-product&product=oval-motif'
            endif
          -%}
          <article class="suiji-home__look-item" data-home-look-item="{{ look_index }}"><a href="{% render 'suiji-localized-menu-url', url: item_url %}"><div class="suiji-home__look-card-image">{% render 'suiji-home-image', image: item_image, alt: item_title, sizes: '(min-width: 990px) 26vw, 85vw' %}</div><div class="suiji-home__look-card-label"><h3>{{ item_title }}</h3><span>{{ item_colour }}</span><span class="suiji-home__look-card-action">{{ look_cta }} <span aria-hidden="true">→</span></span></div></a></article>
        {%- endfor -%}
      </div>
    </div>
    <dialog class="suiji-home__look-dialog" data-home-look-dialog aria-labelledby="{{ home_id }}-look-dialog-title"><div class="suiji-home__dialog-head"><h2 id="{{ home_id }}-look-dialog-title">{{ look_title }}</h2><button type="button" data-home-look-close aria-label="{{ 'suiji_pdp.close' | t | escape }}">×</button></div></dialog>
  </section>

  <section class="suiji-home__newsletter" aria-labelledby="{{ home_id }}-newsletter">
    <div class="suiji-home__newsletter-image" aria-hidden="true">{% render 'suiji-home-image', image: modular_image, alt: '' %}</div>
    <div class="suiji-home__newsletter-panel"><h2 id="{{ home_id }}-newsletter">{{ newsletter_title }}</h2><h3>{{ newsletter_subtitle }}</h3><p>{{ newsletter_body }}</p>
      {%- form 'customer', id: form_id, class: 'suiji-home__form' -%}
        <input type="hidden" name="contact[tags]" value="SUIJI_NEWSLETTER">
        {%- if form.posted_successfully? -%}<p class="suiji-home__form-status" role="status" tabindex="-1">{{ subscribed }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="suiji-home__form-status" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="visually-hidden" for="{{ form_id }}-email">{{ email_label }}</label><div class="suiji-home__email-row"><input id="{{ form_id }}-email" name="contact[email]" type="email" value="{{ form.email }}" autocomplete="email" autocapitalize="off" required aria-required="true" placeholder="{{ email_label | escape }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}><button class="suiji-home__button" type="submit">{{ subscribe }}</button></div>
        <label class="suiji-home__consent"><input type="checkbox" name="contact[consent]" value="explicit" required><span>{{ consent }}{% if shop.privacy_policy != blank %} <a href="{% render 'suiji-localized-menu-url', url: shop.privacy_policy.url %}">{{ privacy_label }}</a>{% endif %}</span></label>
      {%- endform -%}
    </div>
  </section>

  <section class="suiji-home__editorial" aria-labelledby="{{ home_id }}-editorial"><div class="suiji-home__editorial-images"><div>{% render 'suiji-home-image', image: about_image, alt: about_alt, sizes: '(max-width: 749px) 650px, 45vw' %}</div><div>{% render 'suiji-home-image', image: look_image, alt: look_alt, sizes: '(min-width: 750px) 24vw, 45vw' %}</div></div><div class="suiji-home__editorial-copy"><h2 id="{{ home_id }}-editorial">{{ editorial_title }}</h2><p>{{ editorial_body }}</p><a class="suiji-home__button" href="{% render 'suiji-localized-menu-url', url: '/blogs/journal' %}">{{ editorial_cta }} <span aria-hidden="true">→</span></a></div></section>
  <p class="suiji-home__campaign-note">{{ campaign_note }}</p>
</suiji-home-editorial>
{% schema %}
{
  "name": "SUIJI editorial home",
  "tag": "section",
  "class": "section suiji-home-section",
  "settings": [
    {"type":"image_picker","id":"hero_image","label":"Hero campaign image"},
    {"type":"image_picker","id":"modular_image","label":"Modular jewelry composition"},
    {"type":"image_picker","id":"about_image","label":"About campaign image"},
    {"type":"image_picker","id":"look_image","label":"Shop the look campaign image"},
    {"type":"image_picker","id":"necklace_image","label":"Necklace category image"},
    {"type":"image_picker","id":"bracelet_image","label":"Bracelet category image"}
  ],
  "presets":[{"name":"SUIJI editorial home"}]
}
{% endschema %}
