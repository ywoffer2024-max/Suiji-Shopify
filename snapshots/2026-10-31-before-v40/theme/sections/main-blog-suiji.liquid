{{ 'suiji-journal-v2.css' | asset_url | stylesheet_tag }}
{% assign sj_fr = false %}{% if request.locale.iso_code contains 'fr' %}{% assign sj_fr = true %}{% endif %}
{% assign sj_lang = 'en' %}{% if sj_fr %}{% assign sj_lang = 'fr' %}{% endif %}
{% assign sj_root = routes.root_url | append: '/blogs/journal' | replace: '//', '/' %}
<header class="sj-hub-head"><div class="sj-shell"><p class="sj-eyebrow">SUIJI</p><h1>Journal</h1><p>{% if sj_fr %}Des réponses pour choisir, porter et faire évoluer vos bijoux. Partez de la question qui vous concerne.{% else %}Answers to help you choose, wear and evolve your jewelry. Start with the question that matters to you.{% endif %}</p></div></header>
<div class="sj-shell"><nav class="sj-theme-nav" id="journal-themes" aria-label="{% if sj_fr %}Thèmes du Journal{% else %}Journal themes{% endif %}">
<a href="#sj-h1">{% if sj_fr %}Présence et confort{% else %}Presence & comfort{% endif %}</a>
<a href="#sj-h2">{% if sj_fr %}Changer les détails{% else %}Changing the details{% endif %}</a>
<a href="#sj-h3">{% if sj_fr %}Façons de porter{% else %}Ways to wear{% endif %}</a>
<a href="#sj-h4">{% if sj_fr %}Ajustement et gestes{% else %}Fit & handling{% endif %}</a>
<a href="#sj-h5">{% if sj_fr %}Cadeaux et souvenirs{% else %}Gifts & memories{% endif %}</a>
<a href="#sj-h6">{% if sj_fr %}Votre propre dessin{% else %}Your own design{% endif %}</a>
</nav>
<section class="sj-theme-group" id="sj-h1"><div class="sj-group-heading"><p class="sj-eyebrow">SUIJI JOURNAL</p><h2>{% if sj_fr %}Présence et confort{% else %}Presence & comfort{% endif %}</h2></div><div class="sj-guide-grid">{% capture sj_title %}{% render 'suiji-journal-copy', key: 1, field: 'title' %}{% endcapture %}{% capture sj_description %}{% render 'suiji-journal-copy', key: 1, field: 'description' %}{% endcapture %}{% assign sj_image = 'sj-01-' | append: sj_lang | append: '.svg' %}
<a class="sj-guide-card" href="{{ sj_root }}?view=suiji-j01"><img src="{{ sj_image | asset_url }}" width="1200" height="800" loading="lazy" decoding="async" alt="{{ sj_title | strip | escape }}"><div><p class="sj-eyebrow">01 · {% if sj_fr %}Guide pratique{% else %}Practical guide{% endif %}</p><h3>{{ sj_title | strip }}</h3><p>{{ sj_description | strip }}</p><span>{% if sj_fr %}Lire le guide{% else %}Read the guide{% endif %} →</span></div></a>
