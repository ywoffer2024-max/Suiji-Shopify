        "custom_liquid_CVV6JV": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% comment %}SUIJI merchant-authored pairing module, R01 only. Existing Oval Motif variants; no duplicate catalog products. 2026-10-28.{% endcomment %}\n{% if product.handle == 'r01' %}\n{% assign motif_product = all_products['oval-motif'] %}\n{% if request.locale.iso_code == 'fr' %}{% assign suiji_ship_note = 'Précommande — Expédition prévue dans les 3 mois suivant votre commande.' %}{% else %}{% assign suiji_ship_note = 'Pre-order — expected to ship within 3 months of purchase.' %}{% endif %}\n<suiji-complete-look class=\"suiji-look\" data-add-url=\"{{ routes.cart_add_url }}.js\" data-cart-url=\"{{ routes.cart_url }}\" data-add-label=\"{{ 'products.product.add_to_cart' | t | escape }}\" data-sold-label=\"{{ 'products.product.sold_out' | t | escape }}\" data-error-label=\"{{ 'sections.cart.cart_error' | t | escape }}\">\n  <div class=\"suiji-look__header\"><h2 class=\"suiji-look__heading\">Complete the look</h2><a class=\"suiji-look__cart\" href=\"{{ routes.cart_url }}\">{{ 'general.cart.view_empty_cart' | t }} →</a></div>\n  <div class=\"suiji-look__grid\">\n  {% assign look_styles = 'Smooth,Hammered' | split: ',' %}\n  {% for look_style in look_styles %}\n    {% assign look_variants = motif_product.variants | where: 'option1', look_style %}\n    {% assign look_selected = look_variants.first %}\n    {% if look_style == 'Smooth' %}\n      {% assign look_title = 'Smooth oval motif' %}\n      {% assign look_image = 'https://cdn.shopify.com/s/files/1/1041/4112/8020/files/mf-f01-front-f337b8015d3d1e41.png?v=1793146105' %}\n      {% for look_variant in look_variants %}{% if look_variant.option2 == 'Smoky' and look_variant.option3 == 'Gold' %}{% assign look_selected = look_variant %}{% endif %}{% endfor %}\n    {% else %}\n      {% assign look_title = 'Hammered oval motif' %}\n      {% assign look_image = 'https://cdn.shopify.com/s/files/1/1041/4112/8020/files/mf-f02-front-7866b0cf3fed3922.png?v=1793146100' %}\n      {% for look_variant in look_variants %}{% if look_variant.option2 == 'Aqua' and look_variant.option3 == 'Silver' %}{% assign look_selected = look_variant %}{% endif %}{% endfor %}\n    {% endif %}\n    <article class=\"suiji-look__card\" data-look-style=\"{{ look_style | escape }}\">\n      <div class=\"suiji-look__photo\"><img src=\"{{ look_image }}\" alt=\"{{ look_title | escape }}\" width=\"400\" height=\"500\" loading=\"lazy\"></div>\n      <h3 class=\"suiji-look__title\">{{ look_title }}</h3>\n      <p class=\"suiji-look__price\" data-look-price>{% if look_selected != blank %}{{ look_selected.price | money_with_currency }}{% else %}{{ 3900 | money_with_currency }}{% endif %}</p>\n      <div class=\"suiji-look__options\">\n        <button type=\"button\" class=\"suiji-look__toggle\" data-look-toggle aria-expanded=\"false\" aria-controls=\"SuijiLookPanel-{{ section.id }}-{{ forloop.index }}\"><span>{{ 'products.product.choose_options' | t }}</span><span aria-hidden=\"true\" class=\"suiji-look__plus\">+</span></button>\n        <div data-look-panel id=\"SuijiLookPanel-{{ section.id }}-{{ forloop.index }}\" hidden>\n        {% if look_variants.size > 0 %}\n        <form method=\"post\" action=\"{{ routes.cart_add_url }}\" class=\"suiji-look__form\">\n          <label for=\"SuijiLook-{{ section.id }}-{{ forloop.index }}\" class=\"visually-hidden\">{{ 'products.product.product_variants' | t }}: {{ look_title }}</label>\n          <select id=\"SuijiLook-{{ section.id }}-{{ forloop.index }}\" name=\"id\" aria-label=\"{{ look_title | escape }} — {{ 'products.product.product_variants' | t | escape }}\">\n          {% for look_variant in look_variants %}\n            <option value=\"{{ look_variant.id }}\" data-available=\"{{ look_variant.available }}\" data-price=\"{{ look_variant.price | money_with_currency | escape }}\" {% if look_variant.id == look_selected.id %}selected{% endif %}>{{ look_variant.option2 | escape }} / {{ look_variant.option3 | escape }}{% unless look_variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>\n          {% endfor %}\n          </select>\n          <input type=\"hidden\" name=\"quantity\" value=\"1\">\n          <input type=\"hidden\" name=\"properties[Pre-order]\" data-preorder-value value=\"{{ suiji_ship_note | escape }}\">\n          <button type=\"submit\" class=\"button button--secondary suiji-look__add\" {% unless look_selected.available %}disabled{% endunless %}>{% if look_selected.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>\n          <p data-look-error class=\"suiji-look__error\" role=\"status\" aria-live=\"polite\"></p>\n        </form>\n        {% else %}\n          <button class=\"button button--secondary suiji-look__add\" disabled>{{ 'products.product.unavailable' | t }}</button>\n        {% endif %}\n      </div></div>\n    </article>\n  {% endfor %}\n  </div>\n</suiji-complete-look>\n<style>\n.suiji-look{display:block;margin:2.8rem 0 2.4rem;padding-top:2.4rem;border-top:1px solid rgba(var(--color-foreground),.18)}\n.suiji-look__header{display:flex;align-items:baseline;justify-content:space-between;gap:1rem}.suiji-look__cart{font-size:1.15rem;color:inherit;text-underline-offset:3px;white-space:nowrap}.suiji-look__heading{font-family:inherit;font-size:1.8rem;line-height:1.35;font-weight:500;letter-spacing:.02em;margin:0 0 1.8rem}\n.suiji-look__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.8rem}\n.suiji-look__card{min-width:0}.suiji-look__photo{aspect-ratio:4/5;background:#fff;overflow:hidden}\n.suiji-look__photo img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .25s ease}\n.suiji-look__title{font-family:inherit;font-size:1.35rem;font-weight:500;line-height:1.5;letter-spacing:.01em;margin:1.1rem 0 .3rem}\n.suiji-look__price{font-size:1.25rem;line-height:1.5;margin:0 0 .9rem}.suiji-look__options{border-top:1px solid rgba(var(--color-foreground),.14)}\n.suiji-look__toggle{appearance:none;border:0;border-radius:0;background:transparent;color:inherit;font:inherit;text-align:left;width:100%;display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:1rem 0;cursor:pointer;font-size:1.15rem;line-height:1.4}\n.suiji-look [hidden]{display:none!important}.suiji-look__plus{font-size:2rem;line-height:1}.suiji-look__toggle[aria-expanded=\"true\"] .suiji-look__plus{transform:rotate(45deg)}\n.suiji-look__form select{font:inherit;font-size:1.2rem;width:100%;padding:.8rem;border:1px solid #aaa;background:#fff;color:#171717;border-radius:0}\n.suiji-look__add{width:100%;min-height:4rem;margin-top:1rem;padding:.8rem;font-size:1.15rem;min-width:0}.suiji-look__add:disabled{opacity:.55;cursor:not-allowed}\n.suiji-look__error{font-size:1.1rem;color:#8f2626;line-height:1.5;margin:.7rem 0 0}.suiji-look__error:empty{display:none}\n@media(prefers-reduced-motion:reduce){.suiji-look__photo img{transition:none}}\n@media(max-width:480px){.suiji-look__grid{gap:1.2rem}.suiji-look__heading{font-size:1.7rem}.suiji-look__title{font-size:1.25rem}}\n</style>\n<script>\nif(!customElements.get('suiji-complete-look')){\n  customElements.define('suiji-complete-look',class extends HTMLElement{\n    connectedCallback(){\n      if(this.dataset.ready)return;this.dataset.ready='true';\n      this.querySelectorAll('[data-look-toggle]').forEach(toggle=>{toggle.addEventListener('click',()=>{const panel=this.querySelector('#'+toggle.getAttribute('aria-controls'));const open=toggle.getAttribute('aria-expanded')==='true';panel.hidden=open;toggle.setAttribute('aria-expanded',String(!open));});});\n      this.querySelectorAll('form').forEach(form=>{\n        const select=form.querySelector('select[name=\"id\"]'),button=form.querySelector('button[type=\"submit\"]'),error=form.querySelector('[data-look-error]');\n        const sync=()=>{const option=select.selectedOptions[0];button.disabled=option.dataset.available!=='true';button.textContent=button.disabled?this.dataset.soldLabel:this.dataset.addLabel;form.closest('article').querySelector('[data-look-price]').textContent=option.dataset.price;error.textContent='';};\n        select.addEventListener('change',sync);sync();\n        form.addEventListener('submit',async event=>{\n          event.preventDefault();if(form.dataset.busy||select.selectedOptions[0].dataset.available!=='true')return;\n          form.dataset.busy='true';button.disabled=true;form.setAttribute('aria-busy','true');error.textContent='';\n          try{\n            const response=await fetch(this.dataset.addUrl,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({id:Number(select.value),quantity:1,properties:{\"Pre-order\":form.querySelector(\"[data-preorder-value]\").value}})});\n            const result=await response.json();if(!response.ok)throw new Error(result.description||this.dataset.errorLabel);\n            window.location.assign(this.dataset.cartUrl);\n          }catch(reason){error.textContent=reason.message||this.dataset.errorLabel;button.disabled=false;}\n          finally{delete form.dataset.busy;form.removeAttribute('aria-busy');}\n        });\n      });\n    }\n  });\n}\n</script>\n{% endif %}"
